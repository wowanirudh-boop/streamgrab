{
  "manifest_version": 3,
  "name": "StreamGrab - Video Downloader",
  "version": "0.1.5",
  "description": "Download streaming video from any site: HLS (m3u8), DASH, MP4. One click, quality picker. Free Windows desktop app required.",
  "homepage_url": "https://github.com/wowanirudh-boop/streamgrab-releases/releases/latest",
  "key": "",
  "permissions": [
    "webRequest",
    "webNavigation",
    "tabs",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "StreamGrab",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "quality.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
